---
config:
  theme: base
  htmlLabels: true
  flowchart:
    htmlLabels: true
    nodeSpacing: 22
    rankSpacing: 36
    curve: basis
  layout: elk
  themeVariables:
    background: "#ffffff"
    fontFamily: "Inter, DejaVu Sans, Arial, sans-serif"
    fontSize: "16px"
    primaryTextColor: "#1f2937"
    lineColor: "#64748b"
  themeCSS: |
    .nodeLabel { font-size: 16px; }
    .edgeLabel { font-size: 14px; }
    .cluster-label { font-size: 16px; font-weight: 700; }
---
flowchart TB
  A["ADVIO sequence<br/>advio-XX"]

  subgraph REF["Benchmark reference"]
    direction LR
    GT["Ground truth"]
    GTP["pose.csv<br/>reference trajectory<br/>6DoF, 100 Hz"]
    GTF["fixpoints.csv<br/>manual metric location fixes"]
    GT --> GTP
    GT --> GTF
  end

  subgraph DEV["Device-specific modalities"]
    direction TB

    subgraph IPG["iPhone"]
      direction LR
      IP["Primary capture device"]
      IPV["frames.mov + frames.csv<br/>RGB video timestamps<br/>1280x720 portrait, 60 Hz"]
      IPA["arkit.csv<br/>ARKit 6DoF poses<br/>60 Hz"]
      IPIMU["accelerometer.csv + gyro.csv<br/>+ magnetometer.csv<br/>raw IMU sensors, 100 Hz"]
      IPB["barometer.csv<br/>pressure and relative altitude"]
      IPL["platform-locations.csv<br/>lat/lon/alt/speed samples"]
      IP --> IPV
      IP --> IPA
      IP --> IPIMU
      IP --> IPB
      IP --> IPL
    end

    subgraph PXG["Pixel"]
      direction LR
      PX["Secondary baseline device"]
      PXA["arcore.csv<br/>ARCore 6DoF poses<br/>30 Hz"]
      PX --> PXA
    end

    subgraph TGG["Tango"]
      direction LR
      TG["Legacy multi-sensor device"]
      TGR["raw.csv<br/>raw odometry<br/>60 Hz"]
      TGA["area-learning.csv<br/>loop-closing odometry<br/>60 Hz"]
      TGV["frames.mov + frames.csv<br/>fisheye video"]
      TGP["point-cloud.csv + point-cloud-*.csv<br/>timestamped Tango payloads"]
      TG --> TGR
      TG --> TGA
      TG --> TGV
      TG --> TGP
    end
  end

  subgraph AUX["Supporting inputs"]
    direction LR
    CAL["calibration/iphone-XX.yaml<br/>intrinsics, distortion, T_cam_imu"]
    RV["External reference video<br/>used to mark fixpoints"]
    FP["Floor plans / aerial maps<br/>used to place fixpoints"]
  end

  A --> REF
  A --> DEV
  A --> AUX

  CAL -.-> IP
  RV -.-> GTF
  FP -.-> GTF

  classDef input fill:#D5E8D4,stroke:#82B366,stroke-width:1.5px,rx:0,ry:0;
  classDef output fill:#F8CECC,stroke:#B85450,stroke-width:1.5px,rx:0,ry:0;
  classDef compute fill:#E1D5E7,stroke:#9673A6,stroke-width:1.5px,rx:8,ry:8;
  classDef data fill:#F5F5F5,stroke:#9E9E9E,stroke-width:1.2px,rx:0,ry:0;

  class A input;
  class GT output;
  class IP,PX,TG compute;
  class GTP,GTF,IPV,IPA,IPIMU,IPB,IPL,PXA,TGR,TGA,TGV,TGP,CAL,RV,FP data;

  style REF fill:#f1fff6,stroke:#97ddb5,stroke-width:2px,rx:12,ry:12
  style DEV fill:#f0fbff,stroke:#8fd0ff,stroke-width:2px,rx:12,ry:12
  style AUX fill:#ffffff,stroke:#cbd5e1,stroke-width:1.5px,rx:12,ry:12
  style IPG fill:#ffffff,stroke:#cbd5e1,stroke-width:1.2px,rx:12,ry:12
  style PXG fill:#ffffff,stroke:#cbd5e1,stroke-width:1.2px,rx:12,ry:12
  style TGG fill:#ffffff,stroke:#cbd5e1,stroke-width:1.2px,rx:12,ry:12
