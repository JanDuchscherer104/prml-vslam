---
config:
  theme: base
  htmlLabels: true
  flowchart:
    htmlLabels: true
    nodeSpacing: 28
    rankSpacing: 44
    curve: basis
  layout: elk
  themeVariables:
    background: "#ffffff"
    fontFamily: "Inter, DejaVu Sans, Arial, sans-serif"
    fontSize: "16px"
    primaryTextColor: "#1f2937"
    lineColor: "#64748b"
  themeCSS: |
    .nodeLabel { font-size: 16px; }
    .edgeLabel { font-size: 14px; }
    .cluster-label { font-size: 16px; font-weight: 700; }
---
flowchart LR
  IRGB["iPhone RGB frames<br/>iphone/frames.mov + frames.csv"]
  TRGB["Tango fisheye frames<br/>tango/frames.mov + frames.csv"]
  TPC["Tango point-cloud payloads<br/>point-cloud.csv + point-cloud-*.csv"]

  ICAM["iPhone RGB camera frame"]
  PCAM["Pixel ARCore camera frame"]
  TFCAM["Tango fisheye camera frame"]
  TDEV["Tango tracking/device pose frame"]
  TPN["Raw-pose-fused Tango-native<br/>point-cloud geometry"]

  GTW["GT world"]
  ARKW["ARKit world"]
  ARCW["ARCore world"]
  TRW["Tango raw world"]
  TAW["Tango area-learning world"]
  ALIGN["Derived provider-to-GT alignment<br/>time sync + planar rigid fit"]

  IRGB --> ICAM
  TRGB --> TFCAM
  TPC -->|"materialized via raw pose"| TPN

  ICAM -->|"dynamic SE(3)<br/>ground-truth/pose.csv"| GTW
  ICAM -->|"dynamic SE(3)<br/>iphone/arkit.csv"| ARKW
  PCAM -->|"dynamic SE(3)<br/>pixel/arcore.csv"| ARCW
  TDEV -->|"dynamic SE(3)<br/>tango/raw.csv"| TRW
  TDEV -->|"dynamic SE(3)<br/>tango/area-learning.csv"| TAW

  ARKW -.-> ALIGN
  ARCW -.-> ALIGN
  TRW -.-> ALIGN
  TAW -.-> ALIGN
  TPN -.->|"source-native cloud"| ALIGN
  ALIGN -.->|"derived comparison frame"| GTW

  classDef input fill:#D5E8D4,stroke:#82B366,stroke-width:1.5px,rx:0,ry:0;
  classDef output fill:#F8CECC,stroke:#B85450,stroke-width:1.5px,rx:0,ry:0;
  classDef compute fill:#E1D5E7,stroke:#9673A6,stroke-width:1.5px,rx:8,ry:8;
  classDef data fill:#F5F5F5,stroke:#9E9E9E,stroke-width:1.2px,rx:0,ry:0;

  class IRGB,TRGB,TPC input;
  class ICAM,PCAM,TFCAM,TDEV,TPN,ARKW,ARCW,TRW,TAW data;
  class ALIGN compute;
  class GTW output;
